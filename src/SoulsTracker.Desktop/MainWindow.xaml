<Window x:Class="SoulsTracker.Desktop.MainWindow"
        DataContextChanged="Window_DataContextChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewGotKeyboardFocus="Window_PreviewGotKeyboardFocus"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:SoulsTracker.Domain;assembly=SoulsTracker.Domain"
        xmlns:local="clr-namespace:SoulsTracker.Desktop"

        Title="SoulsTracker"
        Icon="/SoulsTracker.Desktop;component/assets/branding/souls-tracker-skull-compact.ico"
        Width="560"
        Height="760"
        MinWidth="560"
        MinHeight="400"
        Background="#15171B"
        Foreground="#F2F4F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#15171B" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#20242B" />
        <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#292E37" />
        <SolidColorBrush x:Key="BorderBrush" Color="#444B59" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F4F8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B8C0CC" />
        <SolidColorBrush x:Key="GameAvailabilityLabelBrush" Color="#E89A9A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E89A9A" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#4A2D32" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4A2D32" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F2F4F8" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#70D6A7" />
        <SolidColorBrush x:Key="WaitingBrush" Color="#F4C66A" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF8C8C" />
        <Style x:Key="KeyboardFocusVisual" TargetType="Control">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="-2" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="5" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="OptionalSaveFeedback" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DirectoryPathContainer" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Tag" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Background" Value="#343B48" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#454F61" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SelectionBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DirectoryChooseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="Change Directory" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Content" Value="Choose Directory" /></Trigger>
                <Trigger Property="Tag" Value=""><Setter Property="Content" Value="Choose Directory" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DirectoryCopyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="ToolTip" Value="Copy directory path" />
            <Setter Property="AutomationProperties.Name" Value="Copy directory path" />
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><Path Width="14" Height="16" Stretch="Uniform" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.5" Data="M 4,4 L 14,4 14,16 4,16 Z M 10,1 L 1,1 1,12" /></DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Content" Value="" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#191D23" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TextBoxSurface" Property="Background" Value="#20242B" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBoxSurface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayUrlTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContextHelpButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="?" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HelpCircle" Width="19" Height="19" BorderBrush="{StaticResource MutedTextBrush}" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HelpCircle" Property="BorderBrush" Value="{StaticResource PrimaryTextBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <EventSetter Event="GotKeyboardFocus" Handler="ContextHelp_GotKeyboardFocus" />
            <EventSetter Event="LostKeyboardFocus" Handler="ContextHelp_LostKeyboardFocus" />
        </Style>
        <Style x:Key="OverlayAppearanceTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="5,4" />
        </Style>
        <Style x:Key="OverlayAppearanceNumberBox" TargetType="TextBox" BasedOn="{StaticResource OverlayAppearanceTextBox}">
            <Setter Property="Width" Value="78" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="TotalDeathsOutlineSizeBox" TargetType="TextBox" BasedOn="{StaticResource OverlayAppearanceNumberBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TotalDeathsAppearanceDraft.IsOutlineWidthInvalid}" Value="True">
                    <Setter Property="BorderBrush" Value="#E06C75" />
                    <Setter Property="ToolTip" Value="Outline size must be between 0 and 8 pixels." />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayAppearanceRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6" />
            <EventSetter Event="SizeChanged" Handler="AppearanceRow_SizeChanged" />
        </Style>
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="2,0">
                            <Track x:Name="PART_Track" VerticalAlignment="Center" Height="8">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{StaticResource AccentBrush}" BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="4,0,0,4" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="#444B59" BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="0,4,4,0" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SliderThumb" Width="16" Height="16" Background="{StaticResource AccentBrush}" BorderBrush="#15171B" BorderThickness="2" Focusable="False">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#FFFFFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource DarkTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Background="#1B1F26" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="16,8,16,0" KeyboardNavigation.TabNavigation="Once" />
                            </Border>
                            <Border Grid.Row="1" x:Name="ContentHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" Margin="0" ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabSurface" Property="Background" Value="#454F61" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SelectionBrush}" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabSurface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                            <Border x:Name="ClosedSurface" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" />
                            <ContentPresenter x:Name="SelectionText" Grid.Column="0" Panel.ZIndex="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <ToggleButton x:Name="PART_ToggleButton" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" CornerRadius="0,4,4,0"><Path Width="9" Height="6" Margin="0,0,11,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{StaticResource MutedTextBrush}" Data="M 0 0 L 9 0 L 4.5 5 Z" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#454F61" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="{StaticResource SelectionBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleSurface" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Slide" StaysOpen="False">
                                <Border x:Name="PopupSurface" MinWidth="{Binding ActualWidth, ElementName=ComboRoot}" MaxHeight="240" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_PopupScrollViewer" Background="{StaticResource SurfaceBrush}" CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ClosedSurface" Property="Background" Value="#343B48" /></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ClosedSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="PopupSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ClosedSurface" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayAppearanceComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="OverlayAppearanceColorField" TargetType="{x:Type local:ColorField}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="OverlayAppearanceCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#454F61" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource SelectionBrush}" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#252A32" /><Setter Property="Foreground" Value="#8B93A1" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ScrollBarArrowButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="#292E37" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border x:Name="ArrowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowBorder" Property="Background" Value="#454F61" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowBorder" Property="Background" Value="{StaticResource SelectionBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ArrowBorder" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#667086" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBorder" Margin="2" Background="{TemplateBinding Background}" CornerRadius="4" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#8A96AD" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="14" Background="#191D23"><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                <RepeatButton Grid.Row="0" Style="{StaticResource ScrollBarArrowButton}" Command="{x:Static ScrollBar.LineUpCommand}" Content="▲" />
                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBarArrowButton}" Command="{x:Static ScrollBar.PageUpCommand}" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollBarThumb}" /></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBarArrowButton}" Command="{x:Static ScrollBar.PageDownCommand}" /></Track.IncreaseRepeatButton></Track>
                <RepeatButton Grid.Row="2" Style="{StaticResource ScrollBarArrowButton}" Command="{x:Static ScrollBar.LineDownCommand}" Content="▼" />
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14" />
            <Setter Property="Background" Value="#191D23" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1F26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image x:Name="SoulsTrackerSkullIcon" Width="38" Height="38" VerticalAlignment="Center" Source="/SoulsTracker.Desktop;component/assets/branding/souls-tracker-skull-compact.png" AutomationProperties.Name="SoulsTracker skull application icon" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="SoulsTracker" />
                    <TextBlock x:Name="HeaderSubtitleTextBlock" Style="{StaticResource MutedText}" Text="Just a simple death tracker." />
                </StackPanel>

            </Grid>
        </Border>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="{StaticResource BackgroundBrush}" BorderThickness="0" AutomationProperties.Name="SoulsTracker workspace tabs">
            <TabItem x:Name="MainWorkspaceTab" Header="Main" AutomationProperties.Name="Main workspace">
        <Grid Margin="24,18">
                <ScrollViewer x:Name="MainContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Tracker workspace">
                <StackPanel>
                    <Border Style="{StaticResource Panel}" AutomationProperties.Name="Game session panel">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="GAME SESSION" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,10" Text="Choose the game currently being tracked." />
                            <ComboBox x:Name="GameSelector"
                                      ItemsSource="{Binding GameChoices}"
                                      SelectedItem="{Binding SelectedGame, Mode=OneWay}"
                                      TextSearch.TextPath="DisplayName"
                                      SelectionChanged="GameSelector_SelectionChanged"
                                      PreviewMouseWheel="GameSelector_PreviewMouseWheel"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      AutomationProperties.Name="{Binding GameSelectionAutomationName, FallbackValue='Game selection'}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}">
                                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource GameAvailabilityLabelBrush}" FontWeight="SemiBold" Text="{Binding AvailabilityLabel}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsEldenRingSelected, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Elden Ring save reader setup">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="ELDEN RING SAVE" />
                                <WrapPanel Margin="0,10,0,8">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding EldenRingDirectoryHeading}" />
                                    <Button Style="{StaticResource ContextHelpButton}" Visibility="{Binding EldenRingDirectoryWasAutomatic, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Elden Ring directory discovery help" AutomationProperties.HelpText="Save directory was found automatically">
                                        <Button.ToolTip><ToolTip Content="Save directory was found automatically" /></Button.ToolTip>
                                    </Button>

                                </WrapPanel>
                                <Border Style="{StaticResource DirectoryPathContainer}" Tag="{Binding EldenRingDirectoryPath}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding EldenRingDirectoryPath}" TextWrapping="Wrap" ToolTip="{Binding EldenRingDirectoryPath}" AutomationProperties.Name="Elden Ring chosen directory" AutomationProperties.HelpText="{Binding EldenRingDirectoryPath}" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource DirectoryCopyButton}" Tag="{Binding EldenRingDirectoryPath}" Click="CopyDirectoryPath_Click" />
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource DirectoryChooseButton}" Tag="{Binding EldenRingDirectoryPath}" Click="BrowseEldenRingSave_Click" Visibility="{Binding IsEldenRingBrowseVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" />
                                    <Button Content="Change Directory" Click="ChangeEldenRingSave_Click" Visibility="{Binding IsEldenRingChangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Change Elden Ring save directory" />
                                    <Button Margin="8,0,0,0" Content="Refresh" Click="RescanEldenRingSaves_Click" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Refresh Elden Ring saves" />
                                    <Button Margin="8,0,0,0" Content="Cancel" Click="CancelEldenRingChange_Click" Visibility="{Binding IsEldenRingCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Cancel Elden Ring save change" />
                                </StackPanel>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsEldenRingSaveSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock FontWeight="SemiBold" Text="Save source" />
                                    <ComboBox x:Name="EldenRingSaveSelector" Margin="0,5,0,0" HorizontalAlignment="Left" Width="190" ItemsSource="{Binding EldenRingSaveChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedEldenRingSaveChoice, Mode=OneWay}" SelectionChanged="EldenRingSave_SelectionChanged" IsEnabled="{Binding IsEldenRingSaveSelectorEnabled}" Visibility="{Binding IsEldenRingSaveSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Elden Ring save" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource OptionalSaveFeedback}" Text="{Binding EldenRingDirectoryActionFeedback}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Elden Ring directory action feedback" />
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="Choose character" />
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <ComboBox x:Name="EldenRingProfileSlotSelector" Width="190" ItemsSource="{Binding EldenRingProfileSlots}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedEldenRingProfileSlot, Mode=OneWay}" SelectionChanged="EldenRingProfileSlot_SelectionChanged" IsEnabled="{Binding CanSelectEldenRingProfile}" AutomationProperties.Name="Elden Ring character slot" />
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBlackMythWukongSelected, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Black Myth Wukong save reader setup">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="BLACK MYTH: WUKONG SAVE" />
                                <WrapPanel Margin="0,10,0,8">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding BlackMythWukongDirectoryHeading}" />
                                    <Button Style="{StaticResource ContextHelpButton}" Visibility="{Binding BlackMythWukongDirectoryWasAutomatic, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Black Myth Wukong directory discovery help" AutomationProperties.HelpText="Save directory was found automatically">
                                        <Button.ToolTip><ToolTip Content="Save directory was found automatically" /></Button.ToolTip>
                                    </Button>

                                </WrapPanel>
                                <Border Style="{StaticResource DirectoryPathContainer}" Tag="{Binding BlackMythWukongDirectoryPath}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding BlackMythWukongDirectoryPath}" TextWrapping="Wrap" ToolTip="{Binding BlackMythWukongDirectoryPath}" AutomationProperties.Name="Black Myth Wukong chosen directory" AutomationProperties.HelpText="{Binding BlackMythWukongDirectoryPath}" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource DirectoryCopyButton}" Tag="{Binding BlackMythWukongDirectoryPath}" Click="CopyDirectoryPath_Click" />
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource DirectoryChooseButton}" Tag="{Binding BlackMythWukongDirectoryPath}" Click="BrowseBlackMythWukongSave_Click" Visibility="{Binding IsWukongBrowseVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" />
                                    <Button Content="Change Directory" Click="ChangeBlackMythWukongSave_Click" Visibility="{Binding IsWukongChangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Change Black Myth Wukong save directory" />
                                    <Button Margin="8,0,0,0" Content="Refresh" Click="RescanBlackMythWukongSaves_Click" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Refresh Black Myth Wukong saves" />
                                    <Button Margin="8,0,0,0" Content="Cancel" Click="CancelBlackMythWukongChange_Click" Visibility="{Binding IsWukongCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Cancel Black Myth Wukong save change" />
                                </StackPanel>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsWukongSaveSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock FontWeight="SemiBold" Text="Choose character" />
                                    <ComboBox x:Name="BlackMythWukongSaveSelector" Margin="0,5,0,0" HorizontalAlignment="Left" Width="190" ItemsSource="{Binding BlackMythWukongSaveChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedBlackMythWukongSaveChoice, Mode=OneWay}" SelectionChanged="BlackMythWukongSave_SelectionChanged" IsEnabled="{Binding IsWukongSaveSelectorEnabled}" Visibility="{Binding IsWukongSaveSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Black Myth Wukong character slot" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource OptionalSaveFeedback}" Text="{Binding BlackMythWukongDirectoryActionFeedback}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Black Myth Wukong directory action feedback" />
                                <TextBlock x:Name="BlackMythWukongSaveMetadataTextBlock"
                                           Margin="0,3,0,0"
                                           Text="{Binding BlackMythWukongSaveMetadataText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           ToolTip="{Binding BlackMythWukongSaveMetadataText, Mode=OneWay}"
                                           AutomationProperties.Name="{Binding BlackMythWukongSaveMetadataText, Mode=OneWay}"
                                           AutomationProperties.HelpText="{Binding BlackMythWukongSaveMetadataText, Mode=OneWay}"
                                           AutomationProperties.LiveSetting="Polite">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BlackMythWukongSaveMetadataText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsLiesOfPSelected, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Lies of P save reader setup">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="LIES OF P SAVE" />
                                <WrapPanel Margin="0,10,0,8">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding LiesOfPDirectoryHeading}" />
                                    <Button Style="{StaticResource ContextHelpButton}" Visibility="{Binding LiesOfPDirectoryWasAutomatic, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Lies of P directory discovery help" AutomationProperties.HelpText="Save directory was found automatically">
                                        <Button.ToolTip><ToolTip Content="Save directory was found automatically" /></Button.ToolTip>
                                    </Button>

                                </WrapPanel>
                                <Border Style="{StaticResource DirectoryPathContainer}" Tag="{Binding LiesOfPDirectoryPath}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding LiesOfPDirectoryPath}" TextWrapping="Wrap" ToolTip="{Binding LiesOfPDirectoryPath}" AutomationProperties.Name="Lies of P chosen directory" AutomationProperties.HelpText="{Binding LiesOfPDirectoryPath}" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource DirectoryCopyButton}" Tag="{Binding LiesOfPDirectoryPath}" Click="CopyDirectoryPath_Click" />
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource DirectoryChooseButton}" Tag="{Binding LiesOfPDirectoryPath}" Click="BrowseLiesOfPSave_Click" Visibility="{Binding IsLiesOfPBrowseVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" />
                                    <Button Content="Change Directory" Click="ChangeLiesOfPSave_Click" Visibility="{Binding IsLiesOfPChangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Change Lies of P save directory" />
                                    <Button Margin="8,0,0,0" Content="Refresh" Click="RescanLiesOfPSaves_Click" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Refresh Lies of P saves" />
                                    <Button Margin="8,0,0,0" Content="Cancel" Click="CancelLiesOfPChange_Click" Visibility="{Binding IsLiesOfPCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Cancel Lies of P save change" />
                                </StackPanel>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsLiesOfPSaveSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock FontWeight="SemiBold" Text="Choose character" />
                                    <ComboBox x:Name="LiesOfPSaveSelector" Margin="0,5,0,0" HorizontalAlignment="Left" Width="190" ItemsSource="{Binding LiesOfPSaveChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedLiesOfPSaveChoice, Mode=OneWay}" SelectionChanged="LiesOfPSave_SelectionChanged" IsEnabled="{Binding IsLiesOfPSaveSelectorEnabled}" Visibility="{Binding IsLiesOfPSaveSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Lies of P character slot" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource OptionalSaveFeedback}" Text="{Binding LiesOfPDirectoryActionFeedback}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Lies of P directory action feedback" />
                            </StackPanel>

                            <Border Margin="0,14,0,0" Padding="10,8" Background="{StaticResource ElevatedSurfaceBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="READER STATUS" />
                                    <TextBlock x:Name="RuntimeReaderStatusTextBlock" Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding RuntimeReaderStatusText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.Name="Game reader status" AutomationProperties.HelpText="{Binding RuntimeReaderStatusText, Mode=OneWay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" /><Style.Triggers>
                                                <DataTrigger Binding="{Binding RuntimeReaderStatusText}" Value="Synced"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding RuntimeReaderStatusText}" Value="Choose a character to continue."><Setter Property="Foreground" Value="{StaticResource WaitingBrush}" /></DataTrigger>
                                            </Style.Triggers></Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,14,0,0" AutomationProperties.Name="Death counter panel">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="TOTAL DEATHS" VerticalAlignment="Center" />
                                <Button x:Name="ManualCounterHelpButton" Style="{StaticResource ContextHelpButton}" Visibility="{Binding IsManualGameSelected, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Manual counter hotkeys help" AutomationProperties.HelpText="Customizable hotkeys for increasing and decreasing the count can be found in the Settings tab.">
                                    <Button.ToolTip><ToolTip><TextBlock MaxWidth="320" TextWrapping="Wrap" Text="{Binding PlacementTarget.(AutomationProperties.HelpText), RelativeSource={RelativeSource AncestorType=ToolTip}}" /></ToolTip></Button.ToolTip>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="TotalDeathsTextBlock" Margin="0,6,0,0" Text="{Binding TotalDeathsText}" TextWrapping="Wrap" AutomationProperties.Name="Current total deaths">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="16" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotalDeathsValueNumeric}" Value="True">
                                                <Setter Property="FontSize" Value="42" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Visibility="{Binding IsManualGameSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Width="78" Click="DecrementDeaths_Click" IsEnabled="{Binding CanDecrementManualDeaths}" Content="−1" AutomationProperties.Name="Decrease manual deaths" />
                                <Button Width="78" Margin="8,0,0,0" Click="IncrementDeaths_Click" IsEnabled="{Binding ControlsEnabled}" Content="+1" AutomationProperties.Name="Increase manual deaths" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsEldenRingMissedDeathAdjustmentAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Elden Ring missed deaths adjustment">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PanelTitle}" VerticalAlignment="Center" Text="MISSED DEATHS" />
                                    <Button x:Name="MissedDeathsHelpButton" Style="{StaticResource ContextHelpButton}" AutomationProperties.Name="Missed deaths help" AutomationProperties.HelpText="Some PvP and invasion-style deaths, including the Great Jar challenge, are excluded from Elden Ring's save files. Customizable hotkeys for increment and decrement of deaths can be found in the Settings tab.">
                                        <Button.ToolTip><ToolTip><TextBlock MaxWidth="320" TextWrapping="Wrap" Text="{Binding PlacementTarget.(AutomationProperties.HelpText), RelativeSource={RelativeSource AncestorType=ToolTip}}" /></ToolTip></Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" Text="Add any missed deaths manually" />
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Saved deaths"/><TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding EldenRingSavedDeathsText}" AutomationProperties.Name="Elden Ring saved deaths"/></Grid>
                                <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Added deaths"/><TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding EldenRingMissedDeaths}" AutomationProperties.Name="Elden Ring added deaths"/></Grid>
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <Button Width="78" Click="DecrementEldenRingMissedDeaths_Click" IsEnabled="{Binding CanDecrementEldenRingMissedDeaths}" Content="−1" AutomationProperties.Name="Remove Elden Ring missed death" />
                                    <Button Width="78" Margin="8,0,0,0" Click="IncrementEldenRingMissedDeaths_Click" IsEnabled="{Binding CanAdjustEldenRingMissedDeaths}" Content="+1" AutomationProperties.Name="Add Elden Ring missed death" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="ErrorMessageTextBlock" Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" AutomationProperties.Name="Tracker error status" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LegacyImportPanel" Style="{StaticResource Panel}" Margin="0,14,0,0" DataContext="{Binding LegacyImport}" Visibility="{Binding DataContext.HasActiveLegacyImport, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Legacy import panel">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="LEGACY SETTINGS" />
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding OfferVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource MutedText}" Text="Legacy settings were found. Review import." />
                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Candidates}"><ItemsControl.ItemTemplate><DataTemplate><Button Margin="0,2" HorizontalAlignment="Left" Tag="{Binding}" Click="ReviewLegacyImport_Click" Content="{Binding DisplayLabel}" AutomationProperties.Name="Review legacy import" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0" Visibility="{Binding ReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding StatusMessage}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding Review.SelectedGameLabel}" />

                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal"><Button Width="110" Content="Cancel" Click="CancelLegacyImport_Click" AutomationProperties.Name="Cancel legacy import" /><Button Width="190" Margin="8,0,0,0" Content="Import reviewed settings" IsEnabled="{Binding CanImport}" IsDefault="False" Click="ImportReviewedSettings_Click" AutomationProperties.Name="Import reviewed settings" /></StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
            </TabItem>
            <TabItem x:Name="OverlayWorkspaceTab" Header="Overlay" AutomationProperties.Name="Overlay workspace">
                <Grid x:Name="OverlayWorkspaceLayout">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer x:Name="OverlayConfigurationScrollViewer" Grid.RowSpan="3" Padding="24,24,24,16" Tag="24,24,24,70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Overlay configuration workspace">
                    <ScrollViewer.Template>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </ScrollViewer.Template>
                    <StackPanel>
                        <Border Style="{StaticResource Panel}" AutomationProperties.Name="Overlay connection panel">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelTitle}" Text="Overlay" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,10" Text="Your overlay URL is a private link. Anyone with it can view the overlay, so only share it where you need to." />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Consolas" IsReadOnly="True" Focusable="True" Style="{StaticResource OverlayUrlTextBox}" KeyboardNavigation.TabNavigation="None" TextWrapping="NoWrap" Text="{Binding HostedOverlay.UrlText, Mode=OneWay}" AutomationProperties.Name="Overlay URL" />
                                    <Button x:Name="CopyTotalDeathsOverlayUrlButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource DirectoryCopyButton}" IsEnabled="{Binding HostedOverlay.CanCopy, FallbackValue=False}" Click="CopyTotalDeathsOverlayUrl_Click" ToolTip="Copy URL" AutomationProperties.Name="Copy URL" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0" Text="{Binding HostedOverlay.StatusText}" AutomationProperties.LiveSetting="Polite">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Try again" IsEnabled="{Binding HostedOverlay.CanRetry}" Visibility="{Binding HostedOverlay.CanRetry, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Click="RetryHostedOverlay_Click" AutomationProperties.Name="Try preparing overlay URL again" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="NormalPreviewSection" Style="{StaticResource Panel}" Margin="0,14,0,0" AutomationProperties.Name="Local appearance preview panel">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelTitle}" Text="Preview" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,10" Text="Preview your changes before applying them to the overlay. Large designs are scaled down to fit this preview. The live overlay keeps your chosen sizes." />
                                <Grid x:Name="NormalPreviewSlot">
                                    <local:AppearancePreview x:Name="LocalAppearancePreview" AutomationProperties.Name="Local Total Deaths appearance preview" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,14,0,0" AutomationProperties.Name="Overlay appearance panel">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelTitle}" Text="APPEARANCE" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,10" Text="The overlay uses these settings. Click Apply to live overlay to show your changes." />
                                        <StackPanel x:Name="AppearanceFields">
                                            <StackPanel.Resources>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource OverlayAppearanceTextBox}" />
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource OverlayAppearanceComboBox}" />
                                                <Style TargetType="{x:Type local:ColorField}" BasedOn="{StaticResource OverlayAppearanceColorField}" />
                                            </StackPanel.Resources>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Title icon"/><ComboBox Grid.Column="1" ItemsSource="{Binding TitleIconModes}" DisplayMemberPath="Label" SelectedItem="{Binding DraftTitleIconModeChoice}" AutomationProperties.Name="Total Deaths title icon"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}" Visibility="{Binding IsTitleIconSelected, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Icon color"/><local:ColorField Grid.Column="1" Value="{Binding TotalDeathsAppearanceDraft.IconColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths icon color"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}" Visibility="{Binding IsAppearanceTitleVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Title"/><TextBox Grid.Column="1" Text="{Binding TotalDeathsAppearanceDraft.Title, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="Overlay title" AutomationProperties.HelpText="Use at most 40 characters." ToolTip="Use at most 40 characters."/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}" Margin="0,6,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Font"/><local:AppearanceFontField Grid.Column="1" Fonts="{Binding LocalFontFamilies}" SelectedFont="{Binding TotalDeathsAppearanceDraft.FontFamily}"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Font size"/><local:AppearanceNumberField Grid.Column="1" Minimum="12" Maximum="96" Unit="px" Value="{Binding TotalDeathsAppearanceDraft.FontSize, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Font size"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Text color"/><local:ColorField Grid.Column="1" Value="{Binding TotalDeathsAppearanceDraft.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths text color"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Text opacity"/><local:AppearanceNumberField Grid.Column="1" Minimum="0" Maximum="100" Unit="%" Value="{Binding TotalDeathsAppearanceDraft.TextOpacity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths text opacity"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Background"/><CheckBox Grid.Column="1" IsChecked="{Binding TotalDeathsAppearanceDraft.BackgroundEnabled}" AutomationProperties.Name="Enable Total Deaths background"/></Grid>
                                            <StackPanel x:Name="TotalDeathsBackgroundDetails" Visibility="{Binding TotalDeathsAppearanceDraft.BackgroundEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Background color"/><local:ColorField Grid.Column="1" Value="{Binding TotalDeathsAppearanceDraft.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths background color"/></Grid>
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Background opacity"/><local:AppearanceNumberField Grid.Column="1" Minimum="0" Maximum="100" Unit="%" Value="{Binding TotalDeathsAppearanceDraft.BackgroundOpacity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths background opacity"/></Grid>
                                            </StackPanel>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}" Margin="0,6,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Outline"/><CheckBox Grid.Column="1" IsChecked="{Binding TotalDeathsAppearanceDraft.OutlineEnabled}" AutomationProperties.Name="Enable Total Deaths outline"/></Grid>
                                            <StackPanel x:Name="TotalDeathsOutlineDetails" Visibility="{Binding TotalDeathsAppearanceDraft.OutlineEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Outline color"/><local:ColorField Grid.Column="1" Value="{Binding TotalDeathsAppearanceDraft.OutlineColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths outline color"/></Grid>
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Outline width"/><local:AppearanceNumberField Grid.Column="1" Minimum="0" Maximum="8" Unit="px" Value="{Binding TotalDeathsAppearanceDraft.OutlineWidth, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths outline width"/></Grid>
                                            </StackPanel>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}" Margin="0,6,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Shadow"/><CheckBox Grid.Column="1" IsChecked="{Binding TotalDeathsAppearanceDraft.ShadowEnabled}" AutomationProperties.Name="Enable Total Deaths shadow"/></Grid>
                                            <StackPanel x:Name="TotalDeathsShadowDetails" Visibility="{Binding TotalDeathsAppearanceDraft.ShadowEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Shadow color"/><local:ColorField Grid.Column="1" Value="{Binding TotalDeathsAppearanceDraft.ShadowColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths shadow color"/></Grid>
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Shadow X"/><local:AppearanceNumberField Grid.Column="1" Minimum="-20" Maximum="20" Unit="px" Value="{Binding TotalDeathsAppearanceDraft.ShadowOffsetX, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths shadow X offset"/></Grid>
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Shadow Y"/><local:AppearanceNumberField Grid.Column="1" Minimum="-20" Maximum="20" Unit="px" Value="{Binding TotalDeathsAppearanceDraft.ShadowOffsetY, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths shadow Y offset"/></Grid>
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Shadow blur"/><local:AppearanceNumberField Grid.Column="1" Minimum="0" Maximum="20" Unit="px" Value="{Binding TotalDeathsAppearanceDraft.ShadowBlur, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths shadow blur"/></Grid>
                                            </StackPanel>

                                        </StackPanel>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="DockedPreviewCard" Grid.RowSpan="2" Style="{StaticResource Panel}" Padding="16,4" Margin="24,0,41,0" VerticalAlignment="Top" Visibility="Collapsed" AutomationProperties.Name="Compact appearance preview panel">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PanelTitle}" Text="Preview" FontSize="12" Margin="0,0,0,2"/>
                        <Grid x:Name="DockedPreviewSlot"/>
                    </StackPanel>
                </Border>
                <Grid x:Name="AppearanceActions" Grid.Row="2" Height="32" Margin="24,8,24,14" Focusable="True" AutomationProperties.Name="Appearance actions">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ApplyAppearanceButton" Background="{StaticResource SelectionBrush}" BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" IsEnabled="{Binding PresentationControlsEnabled}" Click="ApplyTotalDeathsAppearance_Click" Content="Apply to live overlay" />
                        <Button x:Name="ResetSelectedOverlayAppearanceButton" Margin="10,0,0,0" Background="{StaticResource SurfaceBrush}" IsEnabled="{Binding PresentationControlsEnabled}" Click="ResetSelectedOverlayAppearance_Click" Content="Reset" AutomationProperties.Name="Reset selected overlay appearance" />
                    </StackPanel>
                    <TextBlock x:Name="AppearanceApplyStatus" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Total Deaths appearance apply status" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.ToolTip><ToolTip><TextBlock MaxWidth="400" TextWrapping="Wrap" Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}" /></ToolTip></TextBlock.ToolTip>
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E06C75"/><Style.Triggers><DataTrigger Binding="{Binding IsAppearanceApplySuccessful}" Value="True"><Setter Property="Foreground" Value="#8CCB9B"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="SettingsWorkspaceTab" Header="Settings" AutomationProperties.Name="Settings workspace">
                <ScrollViewer x:Name="SettingsContentScrollViewer" Focusable="True" IsTabStop="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,24,24,16" AutomationProperties.Name="Settings workspace content">
                <StackPanel x:Name="SettingsContentStack">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,14" AutomationProperties.Name="Update check settings">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="UPDATES" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,8" Text="Checks GitHub for the latest updates." />
                            <WrapPanel>
                                <Button x:Name="CheckForUpdatesButton" Content="Check for updates" Click="CheckForUpdates_Click" IsEnabled="{Binding CanCheckForUpdates}" AutomationProperties.Name="Check for updates" />

                                <Button x:Name="OpenUpdateReleasePageButton" Margin="8,0,0,0" Content="Open release page" Click="OpenUpdateReleasePage_Click" IsEnabled="{Binding CanOpenAvailableUpdateReleasePage}" AutomationProperties.Name="Open available update release page" />
                            </WrapPanel>
                            <TextBlock x:Name="UpdatePageActionErrorTextBlock" Text="{Binding UpdatePageActionError}" Foreground="{StaticResource DangerBrush}" AutomationProperties.Name="Open release page error" AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Margin" Value="0,6,0,0" />
                                        <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel x:Name="UpdateVersionSummary" Margin="0,8,0,0" AutomationProperties.Name="Update check result" AutomationProperties.LiveSetting="Polite">
                                <TextBlock Style="{StaticResource MutedText}"><Run Text="Current Version: " /><Run Text="{Binding UpdateCurrentVersion, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{StaticResource MutedText}"><Run Text="Latest Version: " /><Run Text="{Binding UpdateLatestVersion, Mode=OneWay}" /></TextBlock>
                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="UpdateStatusLabel" Style="{StaticResource MutedText}" Text="Status:" Margin="0,0,8,0" />
                                    <!-- Reserve the longest supported result at the actual available width. -->
                                    <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Visibility="Hidden" Text="Update information could not be verified. Try again or open the official Releases page." />
                                    <TextBlock x:Name="UpdateCheckStatusTextBlock" Grid.Column="1" Text="{Binding UpdateCheckStatus}" VerticalAlignment="Top" AutomationProperties.Name="Update check status">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateCheckTone}" Value="Current"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateCheckTone}" Value="Available"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateCheckTone}" Value="Error"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUpdateProgressVisible}" Value="True"><Setter Property="Foreground" Value="{StaticResource WaitingBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                            <CheckBox x:Name="CheckForUpdatesOnStartupCheckBox" Content="Check for updates on startup" IsChecked="{Binding CheckForUpdatesOnStartup, Mode=OneWay}" IsEnabled="{Binding ControlsEnabled}" Click="CheckForUpdatesOnStartup_Click" AutomationProperties.Name="Check for updates on startup" />
                            <TextBlock x:Name="UpdatePreferenceStatusTextBlock" Text="{Binding UpdatePreferenceStatus}" AutomationProperties.Name="Startup update setting status" AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" AutomationProperties.Name="Global hotkeys settings">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource PanelTitle}" VerticalAlignment="Center" Text="GLOBAL HOTKEYS" />
                                <Button x:Name="GlobalHotkeysHelpButton" Style="{StaticResource ContextHelpButton}" AutomationProperties.Name="Global hotkeys help" AutomationProperties.HelpText="{Binding GlobalHotkeyUsageDescription, StringFormat={}{0} Choose a field to record. Enter saves; Esc cancels. Both return to the view where recording started.}">
                                    <Button.ToolTip><ToolTip><TextBlock MaxWidth="320" TextWrapping="Wrap" Text="{Binding PlacementTarget.(AutomationProperties.HelpText), RelativeSource={RelativeSource AncestorType=ToolTip}}" /></ToolTip></Button.ToolTip>
                                </Button>
                            </StackPanel>
                            <DockPanel Margin="0,0,0,5"><TextBlock Width="90" VerticalAlignment="Center" Text="Increment" /><TextBox x:Name="IncrementHotkeyTextBox" IsEnabled="{Binding IsGlobalHotkeyConfigurationAvailable}" IsReadOnly="True" Text="{Binding PendingIncrementHotkey, Mode=OneWay}" GotKeyboardFocus="IncrementHotkeyTextBox_GotKeyboardFocus" AutomationProperties.Name="Increment global hotkey" /></DockPanel>
                            <DockPanel><TextBlock Width="90" VerticalAlignment="Center" Text="Decrement" /><TextBox x:Name="DecrementHotkeyTextBox" IsEnabled="{Binding IsGlobalHotkeyConfigurationAvailable}" IsReadOnly="True" Text="{Binding PendingDecrementHotkey, Mode=OneWay}" GotKeyboardFocus="DecrementHotkeyTextBox_GotKeyboardFocus" AutomationProperties.Name="Decrement global hotkey" /></DockPanel>
                            <Button x:Name="ApplyHotkeysButton" IsEnabled="{Binding IsGlobalHotkeyConfigurationAvailable}" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ApplyHotkeysButton_Click" Content="Apply hotkeys" AutomationProperties.Name="Apply global hotkeys" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding GlobalHotkeyUsageDescription}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGlobalHotkeyConfigurationAvailable}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="GlobalHotkeyStatusTextBlock" Margin="0,12,0,0" Text="{Binding GlobalHotkeyStatus, Mode=OneWay}" AutomationProperties.Name="{Binding GlobalHotkeyStatus, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="{Binding IsGlobalHotkeyConfigurationAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GlobalHotkeyStatus}" Value="Global hotkeys are active."><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>


                    <Border Style="{StaticResource Panel}" Margin="0,14,0,0" AutomationProperties.Name="Streaming text export settings">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="STREAMING TEXT EXPORT" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,8" Text="Write local TXT files for text sources in your streaming software." />
                            <StackPanel x:Name="DeathsExportToggleRow" Orientation="Horizontal">
                                <CheckBox x:Name="DeathsExportEnabledCheckBox" Height="16" IsChecked="{Binding IsDeathsExportEnabled, Mode=OneWay}" Checked="DeathsExportEnabled_Checked" Unchecked="DeathsExportEnabled_Unchecked" AutomationProperties.Name="Enable writing Deaths to txt file">
                                    <TextBlock><Run Text="Enable writing " /><Run FontWeight="Bold" Text="Deaths" /><Run Text=" to txt file" /></TextBlock>
                                </CheckBox>
                            </StackPanel>
                            <TextBlock x:Name="DeathsExportFileNameTextBlock" Text="{Binding DeathsExportFileName, Mode=OneWay, TargetNullValue=No file selected.}" AutomationProperties.Name="Deaths export file name" />
                            <StackPanel Orientation="Horizontal"><Button x:Name="ChooseDeathsExportButton" Content="Choose…" Click="ChooseDeathsExport_Click" IsEnabled="{Binding CanChooseDeathsExport}" AutomationProperties.Name="Choose deaths text file" /><Button x:Name="ClearDeathsExportButton" Margin="8,0,0,0" Content="Clear" Click="ClearDeathsExport_Click" IsEnabled="{Binding CanClearDeathsExport}" AutomationProperties.Name="Clear deaths text file" /></StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#1B1F26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,10">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource MutedText}">More at <Hyperlink x:Name="BeingKairoAttributionHyperlink" NavigateUri="https://www.beingkairo.com/" RequestNavigate="BeingKairoAttributionHyperlink_RequestNavigate" AutomationProperties.Name="Visit beingkairo.com (opens in default browser)" ToolTip="Open beingkairo.com in your default browser">beingkairo.com</Hyperlink></TextBlock>
        </Border>

        <Canvas x:Name="FloatingFeedbackLayer" Grid.Row="1" Panel.ZIndex="11" IsHitTestVisible="False" ClipToBounds="True">
            <Border x:Name="CopyFeedbackOverlay" Padding="8,5" Background="{StaticResource ElevatedSurfaceBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="DirectoryCopyStatus" Style="{StaticResource OptionalSaveFeedback}" Margin="0" AutomationProperties.Name="Directory copy status" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Border x:Name="HostedCopyFeedbackOverlay" Padding="8,5" Background="{StaticResource ElevatedSurfaceBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="HostedCopyStatus" Style="{StaticResource OptionalSaveFeedback}" Margin="0" AutomationProperties.Name="Overlay URL copy status" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Border x:Name="HotkeySuccessOverlay" Padding="8,5" Background="{StaticResource ElevatedSurfaceBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="HotkeySuccessStatus" Style="{StaticResource OptionalSaveFeedback}" Foreground="{StaticResource SuccessBrush}" Margin="0" AutomationProperties.Name="Hotkey apply confirmation" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Canvas>

        <Grid x:Name="HotkeyRecordingOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="20"
              Background="#A8000000"
              Visibility="{Binding IsHotkeyRecording, Converter={StaticResource BooleanToVisibilityConverter}}"
              Focusable="True"
              AutomationProperties.Name="Global hotkey recording">
            <Border Width="430" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#20242B" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,9,0" Fill="#FF4D4D" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Global hotkey recording" />
                    </StackPanel>
                    <TextBlock Margin="0,18,0,0" Style="{StaticResource MutedText}" Text="Press the input that you want to use as a hotkey then click enter to save." />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="Press ESC to cancel." />
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="EldenRingNoticeOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="21"
              Background="#A8000000"
              Visibility="{Binding IsEldenRingNoticeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              FocusManager.IsFocusScope="True"
              AutomationProperties.Name="Set up Elden Ring">
            <Border x:Name="EldenRingNoticeDialog" Focusable="True" AutomationProperties.Name="Set up Elden Ring" Width="480" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#20242B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Set up Elden Ring" />
                    <TextBlock Margin="0,18,0,0" Style="{StaticResource MutedText}" Text="All Elden Ring characters are stored in ER0000.sl2." />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="Choose the save directory, then the character to track." />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="Typical directory: %APPDATA%\EldenRing\&lt;your Steam ID&gt;" />
                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="EldenRingNoticeCancelButton" Margin="0,0,8,0" Content="Not now" Click="CancelEldenRingNotice_Click" AutomationProperties.Name="Not now" />
                        <Button x:Name="EldenRingNoticeConfirmButton" Content="Got it" Click="ConfirmEldenRingNotice_Click" AutomationProperties.Name="Got it" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
