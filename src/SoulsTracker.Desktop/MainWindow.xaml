<Window x:Class="SoulsTracker.Desktop.MainWindow"
        DataContextChanged="Window_DataContextChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewGotKeyboardFocus="Window_PreviewGotKeyboardFocus"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:SoulsTracker.Domain;assembly=SoulsTracker.Domain"
        xmlns:local="clr-namespace:SoulsTracker.Desktop"

        Title="SoulsTracker"
        Icon="/SoulsTracker.Desktop;component/assets/branding/souls-tracker-skull-compact.ico"
        Width="1060"
        Height="760"
        MinWidth="560"
        MinHeight="400"
        Background="#15171B"
        Foreground="#F2F4F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#15171B" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#20242B" />
        <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#292E37" />
        <SolidColorBrush x:Key="BorderBrush" Color="#444B59" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F4F8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B8C0CC" />
        <SolidColorBrush x:Key="GameAvailabilityLabelBrush" Color="#D8D2FF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A78BFA" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#70D6A7" />
        <SolidColorBrush x:Key="WaitingBrush" Color="#F4C66A" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF8C8C" />
        <Style x:Key="KeyboardFocusVisual" TargetType="Control">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="-2" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="5" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#343B48" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#454F61" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#191D23" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TextBoxSurface" Property="Background" Value="#20242B" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBoxSurface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayAppearanceTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="5,4" />
        </Style>
        <Style x:Key="OverlayAppearanceNumberBox" TargetType="TextBox" BasedOn="{StaticResource OverlayAppearanceTextBox}">
            <Setter Property="Width" Value="78" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="TotalDeathsOutlineSizeBox" TargetType="TextBox" BasedOn="{StaticResource OverlayAppearanceNumberBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TotalDeathsAppearanceDraft.IsOutlineWidthInvalid}" Value="True">
                    <Setter Property="BorderBrush" Value="#E06C75" />
                    <Setter Property="ToolTip" Value="Outline size must be between 0 and 8 pixels." />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayAppearanceRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="2,0">
                            <Track x:Name="PART_Track" VerticalAlignment="Center" Height="8">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{StaticResource AccentBrush}" BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="4,0,0,4" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="#444B59" BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="0,4,4,0" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SliderThumb" Width="16" Height="16" Background="#D8D2FF" BorderBrush="#15171B" BorderThickness="2" Focusable="False">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#FFFFFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <Border x:Name="FocusRing" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0" CornerRadius="4" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource DarkTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Background="#1B1F26" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="16,8,16,0" KeyboardNavigation.TabNavigation="Once" />
                            </Border>
                            <Border Grid.Row="1" x:Name="ContentHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" Margin="0" ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#292E37" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabSurface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                            <Border x:Name="ClosedSurface" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" />
                            <ContentPresenter x:Name="SelectionText" Grid.Column="0" Panel.ZIndex="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <ToggleButton x:Name="PART_ToggleButton" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" CornerRadius="0,4,4,0"><Path Width="9" Height="6" Margin="0,0,11,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{StaticResource MutedTextBrush}" Data="M 0 0 L 9 0 L 4.5 5 Z" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#454F61" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#5A4A88" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleSurface" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Slide" StaysOpen="False">
                                <Border x:Name="PopupSurface" MinWidth="{Binding ActualWidth, ElementName=ComboRoot}" MaxHeight="240" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_PopupScrollViewer" Background="{StaticResource SurfaceBrush}" CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ClosedSurface" Property="Background" Value="#343B48" /></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ClosedSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="PopupSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ClosedSurface" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayAppearanceComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="OverlayAppearanceColorField" TargetType="{x:Type local:ColorField}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="OverlayAppearanceCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#454F61" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#5A4A88" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#252A32" /><Setter Property="Foreground" Value="#8B93A1" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ScrollBarArrowButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="#292E37" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border x:Name="ArrowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowBorder" Property="Background" Value="#454F61" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowBorder" Property="Background" Value="#5A4A88" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ArrowBorder" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#667086" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBorder" Margin="2" Background="{TemplateBinding Background}" CornerRadius="4" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#8A96AD" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="14" Background="#191D23"><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                <RepeatButton Grid.Row="0" Style="{StaticResource ScrollBarArrowButton}" Command="{x:Static ScrollBar.LineUpCommand}" Content="▲" />
                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBarArrowButton}" Command="{x:Static ScrollBar.PageUpCommand}" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollBarThumb}" /></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBarArrowButton}" Command="{x:Static ScrollBar.PageDownCommand}" /></Track.IncreaseRepeatButton></Track>
                <RepeatButton Grid.Row="2" Style="{StaticResource ScrollBarArrowButton}" Command="{x:Static ScrollBar.LineDownCommand}" Content="▼" />
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14" />
            <Setter Property="Background" Value="#191D23" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1F26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image x:Name="SoulsTrackerSkullIcon" Width="38" Height="38" VerticalAlignment="Center" Source="/SoulsTracker.Desktop;component/assets/branding/souls-tracker-skull-compact.png" AutomationProperties.Name="SoulsTracker skull application icon" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="SoulsTracker" />
                    <TextBlock x:Name="HeaderSubtitleTextBlock" Style="{StaticResource MutedText}" Text="Death Tracker" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="{StaticResource BackgroundBrush}" BorderThickness="0" AutomationProperties.Name="SoulsTracker workspace tabs">
            <TabItem x:Name="MainWorkspaceTab" Header="Main" AutomationProperties.Name="Main workspace">
        <Grid Margin="24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="0" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" MinWidth="220" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="MainContentScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0" AutomationProperties.Name="Tracker workspace">
                <StackPanel>
                    <Border Style="{StaticResource Panel}" AutomationProperties.Name="Game session panel">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="GAME SESSION" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,10" Text="Choose the game currently being tracked." />
                            <ComboBox x:Name="GameSelector"
                                      ItemsSource="{Binding GameChoices}"
                                      SelectedItem="{Binding SelectedGame, Mode=OneWay}"
                                      TextSearch.TextPath="DisplayName"
                                      SelectionChanged="GameSelector_SelectionChanged"
                                      PreviewMouseWheel="GameSelector_PreviewMouseWheel"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      AutomationProperties.Name="{Binding GameSelectionAutomationName, FallbackValue='Game selection'}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}">
                                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource GameAvailabilityLabelBrush}" FontWeight="SemiBold" Text="{Binding AvailabilityLabel}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsEldenRingSelected, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Elden Ring save reader setup">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="ELDEN RING SAVE" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,8" Text="Choose a local save, then the character to track." />
                                <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="1. Choose save" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="EldenRingSaveSelector" Width="190" ItemsSource="{Binding EldenRingSaveChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedEldenRingSaveChoice, Mode=OneWay}" SelectionChanged="EldenRingSave_SelectionChanged" IsEnabled="{Binding IsEldenRingSaveSelectorEnabled}" Visibility="{Binding IsEldenRingSaveSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Elden Ring save" />
                                    <Button Margin="8,0,0,0" Content="Browse…" Click="BrowseEldenRingSave_Click" Visibility="{Binding IsEldenRingBrowseVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Choose Elden Ring save file" />
                                    <Button Margin="8,0,0,0" Content="Rescan" Click="RescanEldenRingSaves_Click" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Rescan Elden Ring saves" />
                                    <Button Margin="8,0,0,0" Content="Change…" Click="ChangeEldenRingSave_Click" Visibility="{Binding IsEldenRingChangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Change Elden Ring save" />
                                    <Button Margin="8,0,0,0" Content="Cancel" Click="CancelEldenRingChange_Click" Visibility="{Binding IsEldenRingCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Cancel Elden Ring save change" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" MinHeight="18" Text="{Binding EldenRingSaveDiscoveryStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EldenRingSaveDiscoveryStatus}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Elden Ring save discovery status" AutomationProperties.HelpText="{Binding EldenRingSaveDiscoveryStatus}" />
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="2. Choose character" />
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <ComboBox x:Name="EldenRingProfileSlotSelector" Width="190" ItemsSource="{Binding EldenRingProfileSlots}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedEldenRingProfileSlot, Mode=OneWay}" SelectionChanged="EldenRingProfileSlot_SelectionChanged" IsEnabled="{Binding CanSelectEldenRingProfile}" AutomationProperties.Name="Elden Ring character slot" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0" Text="{Binding EldenRingCharacterStatus}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Elden Ring character selection status" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBlackMythWukongSelected, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Black Myth Wukong save reader setup">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="BLACK MYTH: WUKONG SAVE" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,8" Text="Choose a local save slot to track." />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="BlackMythWukongSaveSelector" Width="190" ItemsSource="{Binding BlackMythWukongSaveChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedBlackMythWukongSaveChoice, Mode=OneWay}" SelectionChanged="BlackMythWukongSave_SelectionChanged" IsEnabled="{Binding IsWukongSaveSelectorEnabled}" Visibility="{Binding IsWukongSaveSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Black Myth Wukong save slot" />
                                    <Button Margin="8,0,0,0" Content="Browse…" Click="BrowseBlackMythWukongSave_Click" Visibility="{Binding IsWukongBrowseVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Choose Black Myth Wukong save file" />
                                    <Button Margin="8,0,0,0" Content="Rescan" Click="RescanBlackMythWukongSaves_Click" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Rescan Black Myth Wukong saves" />
                                    <Button Margin="8,0,0,0" Content="Change…" Click="ChangeBlackMythWukongSave_Click" Visibility="{Binding IsWukongChangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Change Black Myth Wukong save file" />
                                    <Button Margin="8,0,0,0" Content="Cancel" Click="CancelBlackMythWukongChange_Click" Visibility="{Binding IsWukongCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Cancel Black Myth Wukong save change" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" MinHeight="18" Text="{Binding BlackMythWukongSaveDiscoveryStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BlackMythWukongSaveDiscoveryStatus}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Black Myth Wukong save discovery status" AutomationProperties.HelpText="{Binding BlackMythWukongSaveDiscoveryStatus}" />
                                <TextBlock x:Name="BlackMythWukongSaveMetadataTextBlock"
                                           Margin="0,3,0,0"
                                           Text="{Binding BlackMythWukongSaveMetadataText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           ToolTip="{Binding BlackMythWukongSaveMetadataText, Mode=OneWay}"
                                           AutomationProperties.Name="{Binding BlackMythWukongSaveMetadataText, Mode=OneWay}"
                                           AutomationProperties.HelpText="{Binding BlackMythWukongSaveMetadataText, Mode=OneWay}"
                                           AutomationProperties.LiveSetting="Polite">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BlackMythWukongSaveMetadataText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsLiesOfPSelected, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Lies of P save reader setup">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="LIES OF P SAVE" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,8" Text="Choose a local character save to track." />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="LiesOfPSaveSelector" Width="190" ItemsSource="{Binding LiesOfPSaveChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedLiesOfPSaveChoice, Mode=OneWay}" SelectionChanged="LiesOfPSave_SelectionChanged" IsEnabled="{Binding IsLiesOfPSaveSelectorEnabled}" Visibility="{Binding IsLiesOfPSaveSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Lies of P character save" />
                                    <Button Margin="8,0,0,0" Content="Browse…" Click="BrowseLiesOfPSave_Click" Visibility="{Binding IsLiesOfPBrowseVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Choose Lies of P save file" />
                                    <Button Margin="8,0,0,0" Content="Rescan" Click="RescanLiesOfPSaves_Click" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Rescan Lies of P saves" />
                                    <Button Margin="8,0,0,0" Content="Change…" Click="ChangeLiesOfPSave_Click" Visibility="{Binding IsLiesOfPChangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Change Lies of P save file" />
                                    <Button Margin="8,0,0,0" Content="Cancel" Click="CancelLiesOfPChange_Click" Visibility="{Binding IsLiesOfPCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.Name="Cancel Lies of P save change" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" MinHeight="18" Text="{Binding LiesOfPSaveDiscoveryStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LiesOfPSaveDiscoveryStatus}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Lies of P save discovery status" AutomationProperties.HelpText="{Binding LiesOfPSaveDiscoveryStatus}" />
                            </StackPanel>
                            <Border Margin="0,14,0,0" Padding="10,8" Background="{StaticResource ElevatedSurfaceBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="READER STATUS" />
                                    <TextBlock x:Name="RuntimeReaderStatusTextBlock" Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding RuntimeReaderStatusText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.Name="Game reader status" AutomationProperties.HelpText="{Binding RuntimeReaderStatusText, Mode=OneWay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" /><Style.Triggers>
                                                <DataTrigger Binding="{Binding RuntimeReaderStatusText}" Value="Synced"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding RuntimeReaderStatusText}" Value="Game detected — waiting for active character"><Setter Property="Foreground" Value="{StaticResource WaitingBrush}" /></DataTrigger>
                                            </Style.Triggers></Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,14,0,0" AutomationProperties.Name="Death counter panel">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="TOTAL DEATHS" />
                            <TextBlock x:Name="TotalDeathsTextBlock" Margin="0,6,0,0" Text="{Binding TotalDeathsText}" TextWrapping="Wrap" AutomationProperties.Name="Current total deaths">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="16" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotalDeathsValueNumeric}" Value="True">
                                                <Setter Property="FontSize" Value="42" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Visibility="{Binding IsManualGameSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Width="78" Click="IncrementDeaths_Click" IsEnabled="{Binding ControlsEnabled}" Content="+1" AutomationProperties.Name="Increase manual deaths" />
                                <Button Width="78" Margin="8,0,0,0" Click="DecrementDeaths_Click" IsEnabled="{Binding CanDecrementManualDeaths}" Content="−1" AutomationProperties.Name="Decrease manual deaths" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsEldenRingMissedDeathAdjustmentAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Elden Ring missed deaths adjustment">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="MISSED DEATHS" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" Text="Some PvP and invasion-style deaths, including the Great Jar challenge, may be excluded from Elden Ring's saved death total. Add any missed deaths here." TextWrapping="Wrap" />
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Saved deaths"/><TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding EldenRingSavedDeathsText}" AutomationProperties.Name="Elden Ring saved deaths"/></Grid>
                                <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Added deaths"/><TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding EldenRingMissedDeaths}" AutomationProperties.Name="Elden Ring added deaths"/></Grid>
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <Button Width="78" Click="IncrementEldenRingMissedDeaths_Click" IsEnabled="{Binding CanAdjustEldenRingMissedDeaths}" Content="+1" AutomationProperties.Name="Add Elden Ring missed death" />
                                    <Button Width="78" Margin="8,0,0,0" Click="DecrementEldenRingMissedDeaths_Click" IsEnabled="{Binding CanDecrementEldenRingMissedDeaths}" Content="−1" AutomationProperties.Name="Remove Elden Ring missed death" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="GlobalHotkeyStatusTextBlock" Style="{StaticResource MutedText}" Margin="0,12,0,0" Visibility="{Binding IsGlobalHotkeyConfigurationAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding GlobalHotkeyStatus, Mode=OneWay}" AutomationProperties.Name="{Binding GlobalHotkeyStatus, Mode=OneWay}" />
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsGlobalHotkeyConfigurationAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="GLOBAL HOTKEYS" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,8" Text="{Binding GlobalHotkeyUsageDescription}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Global hotkey usage" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" Text="Choose a field to record. Enter saves and returns to the main menu; Esc cancels." />
                                <DockPanel Margin="0,0,0,5"><TextBlock Width="90" VerticalAlignment="Center" Text="Increment" /><TextBox x:Name="IncrementHotkeyTextBox" IsReadOnly="True" Text="{Binding PendingIncrementHotkey, Mode=OneWay}" GotKeyboardFocus="IncrementHotkeyTextBox_GotKeyboardFocus" AutomationProperties.Name="Increment global hotkey" /></DockPanel>
                                <DockPanel><TextBlock Width="90" VerticalAlignment="Center" Text="Decrement" /><TextBox x:Name="DecrementHotkeyTextBox" IsReadOnly="True" Text="{Binding PendingDecrementHotkey, Mode=OneWay}" GotKeyboardFocus="DecrementHotkeyTextBox_GotKeyboardFocus" AutomationProperties.Name="Decrement global hotkey" /></DockPanel>
                                <Button x:Name="ApplyHotkeysButton" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ApplyHotkeysButton_Click" Content="Apply hotkeys" AutomationProperties.Name="Apply global hotkeys" />
                            </StackPanel>
                            <TextBlock x:Name="ErrorMessageTextBlock" Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" AutomationProperties.Name="Tracker error status" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LegacyImportPanel" Style="{StaticResource Panel}" Margin="0,14,0,0" DataContext="{Binding LegacyImport}" Visibility="{Binding DataContext.HasActiveLegacyImport, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Legacy import panel">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="LEGACY SETTINGS" />
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding OfferVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource MutedText}" Text="Legacy settings were found. Review import." />
                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Candidates}"><ItemsControl.ItemTemplate><DataTemplate><Button Margin="0,2" HorizontalAlignment="Left" Tag="{Binding}" Click="ReviewLegacyImport_Click" Content="{Binding DisplayLabel}" AutomationProperties.Name="Review legacy import" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0" Visibility="{Binding ReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding StatusMessage}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding Review.SelectedGameLabel}" />

                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal"><Button Width="110" Content="Cancel" Click="CancelLegacyImport_Click" AutomationProperties.Name="Cancel legacy import" /><Button Width="190" Margin="8,0,0,0" Content="Import reviewed settings" IsEnabled="{Binding CanImport}" IsDefault="False" Click="ImportReviewedSettings_Click" AutomationProperties.Name="Import reviewed settings" /></StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
            </TabItem>
            <TabItem x:Name="OverlayWorkspaceTab" Header="Overlay" AutomationProperties.Name="Overlay workspace">
                <Grid x:Name="OverlayWorkspaceLayout" Margin="24,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="0" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" MinWidth="220" />
                    </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="OverlayConfigurationScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0" AutomationProperties.Name="Overlay configuration workspace">
                    <StackPanel>
                        <Border Style="{StaticResource Panel}" AutomationProperties.Name="Overlay connection panel">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelTitle}" Text="OVERLAY CONNECTION" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,10" Text="Pairing sends the accepted death display and applied appearance, including your title and font name, to Cloudflare. Cloudflare retains the last published state and processes connection metadata. Game saves, paths and character details stay local." />
                                <CheckBox x:Name="HostedConsentCheckBox" Content="I agree to hosted publication when importing pairing" IsEnabled="{Binding HostedOverlay.CanImport, FallbackValue=False}" AutomationProperties.Name="Consent to hosted publication" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,8" Text="Import an operator-issued version 1 JSON file. It contains sensitive read and write capabilities; protect the original file. Import does not delete it. No production host is authorized in this build." />
                                <Button x:Name="ImportHostedPairingButton" Content="Import / Replace pairing" Click="ImportHostedPairing_Click" AutomationProperties.Name="Import or replace hosted pairing">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HostedOverlay.CanImport}" Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=HostedConsentCheckBox}" Value="True" />
                                            </MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True" /></MultiDataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock x:Name="HostedHostTextBlock" Style="{StaticResource MutedText}" Margin="0,8,0,4" Text="{Binding HostedOverlay.Host}" AutomationProperties.Name="Hosted overlay host" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding HostedOverlay.StatusText}" AutomationProperties.Name="Hosted delivery status" />
                                <WrapPanel Margin="0,8,0,8">
                                    <Button x:Name="CopyTotalDeathsOverlayUrlButton" Content="Copy OBS URL" IsEnabled="{Binding HostedOverlay.CanCopy, FallbackValue=False}" Click="CopyTotalDeathsOverlayUrl_Click" AutomationProperties.Name="Copy read-only OBS URL" />
                                    <Button Content="Reconnect" Margin="8,0,0,0" IsEnabled="{Binding HostedOverlay.CanReconnect, FallbackValue=False}" Click="ReconnectHosted_Click" AutomationProperties.Name="Reconnect hosted publisher" />
                                    <Button Content="Remove pairing" Margin="8,0,0,0" IsEnabled="{Binding HostedOverlay.CanRemove, FallbackValue=False}" Click="RemoveHostedPairing_Click" AutomationProperties.Name="Remove local hosted pairing" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" Text="Replace the old OBS Browser Source URL once. The new URL is read-only and private. Reproduce old URL styles with Desktop appearance settings. Total Deaths below controls visibility only; it does not withdraw publication consent." />
                                <CheckBox x:Name="TotalDeathsOverlayEnabledCheckBox" Content="Total Deaths" IsChecked="{Binding IsTotalDeathsOverlayEnabled, Mode=OneWay}" IsEnabled="{Binding PresentationControlsEnabled}" Checked="TotalDeathsOverlayEnabled_Checked" Unchecked="TotalDeathsOverlayEnabled_Unchecked" AutomationProperties.Name="Show Total Deaths overlay" />

                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,14,0,0" AutomationProperties.Name="Overlay appearance panel">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelTitle}" Text="APPEARANCE" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,10" Text="The hosted overlay uses applied Desktop settings. Draft edits stay local until Apply; the OBS URL does not change." />
                                <TabControl x:Name="OverlayTypeTabs" SelectionChanged="OverlayTypeTabs_SelectionChanged">
                                    <TabItem Header="Total Deaths">
                                        <StackPanel Margin="12">
                                            <StackPanel.Resources>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource OverlayAppearanceTextBox}" />
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource OverlayAppearanceComboBox}" />
                                                <Style TargetType="{x:Type local:ColorField}" BasedOn="{StaticResource OverlayAppearanceColorField}" />
                                            </StackPanel.Resources>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Title"/><TextBox Grid.Column="1" Text="{Binding TotalDeathsAppearanceDraft.Title, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Title icon"/><ComboBox Grid.Column="1" ItemsSource="{Binding TitleIconModes}" DisplayMemberPath="Label" SelectedItem="{Binding DraftTitleIconModeChoice}" AutomationProperties.Name="Total Deaths title icon"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}" Visibility="{Binding IsTitleIconSelected, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Skull color"/><local:ColorField Grid.Column="1" Value="{Binding TotalDeathsAppearanceDraft.IconColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths skull color"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}" Margin="0,6,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Font"/><ComboBox Grid.Column="1" ItemsSource="{Binding LocalFontFamilies}" SelectedItem="{Binding TotalDeathsAppearanceDraft.FontFamily}"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Size"/><TextBox Grid.Column="1" Style="{StaticResource OverlayAppearanceNumberBox}" Text="{Binding TotalDeathsAppearanceDraft.FontSize}"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Text color"/><local:ColorField Grid.Column="1" Value="{Binding TotalDeathsAppearanceDraft.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths text color"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Text opacity"/><TextBox Grid.Column="1" Style="{StaticResource OverlayAppearanceNumberBox}" Text="{Binding TotalDeathsAppearanceDraft.TextOpacity}" AutomationProperties.Name="Total Deaths text opacity"/></Grid>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Background"/><CheckBox Grid.Column="1" IsChecked="{Binding TotalDeathsAppearanceDraft.BackgroundEnabled}" AutomationProperties.Name="Enable Total Deaths background"/></Grid>
                                            <StackPanel x:Name="TotalDeathsBackgroundDetails" Visibility="{Binding TotalDeathsAppearanceDraft.BackgroundEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Background color"/><local:ColorField Grid.Column="1" Value="{Binding TotalDeathsAppearanceDraft.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths background color"/></Grid>
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Background opacity"/><TextBox Grid.Column="1" Style="{StaticResource OverlayAppearanceNumberBox}" Text="{Binding TotalDeathsAppearanceDraft.BackgroundOpacity}" AutomationProperties.Name="Total Deaths background opacity"/></Grid>
                                            </StackPanel>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}" Margin="0,6,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Outline"/><CheckBox Grid.Column="1" IsChecked="{Binding TotalDeathsAppearanceDraft.OutlineEnabled}" AutomationProperties.Name="Enable Total Deaths outline"/></Grid>
                                            <StackPanel x:Name="TotalDeathsOutlineDetails" Visibility="{Binding TotalDeathsAppearanceDraft.OutlineEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Outline color"/><local:ColorField Grid.Column="1" Value="{Binding TotalDeathsAppearanceDraft.OutlineColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths outline color"/></Grid>
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Outline size"/><TextBox Grid.Column="1" Style="{StaticResource TotalDeathsOutlineSizeBox}" Text="{Binding TotalDeathsAppearanceDraft.OutlineWidth}" AutomationProperties.Name="Total Deaths outline size"/></Grid>
                                            </StackPanel>
                                            <Grid Style="{StaticResource OverlayAppearanceRow}" Margin="0,6,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Shadow"/><CheckBox Grid.Column="1" IsChecked="{Binding TotalDeathsAppearanceDraft.ShadowEnabled}" AutomationProperties.Name="Enable Total Deaths shadow"/></Grid>
                                            <StackPanel x:Name="TotalDeathsShadowDetails" Visibility="{Binding TotalDeathsAppearanceDraft.ShadowEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Shadow color"/><local:ColorField Grid.Column="1" Value="{Binding TotalDeathsAppearanceDraft.ShadowColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Total Deaths shadow color"/></Grid>
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Shadow X / Y"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Style="{StaticResource OverlayAppearanceNumberBox}" Text="{Binding TotalDeathsAppearanceDraft.ShadowOffsetX}" AutomationProperties.Name="Total Deaths shadow X offset"/><TextBox Margin="6,0,0,0" Style="{StaticResource OverlayAppearanceNumberBox}" Text="{Binding TotalDeathsAppearanceDraft.ShadowOffsetY}" AutomationProperties.Name="Total Deaths shadow Y offset"/></StackPanel></Grid>
                                                <Grid Style="{StaticResource OverlayAppearanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Shadow blur"/><TextBox Grid.Column="1" Style="{StaticResource OverlayAppearanceNumberBox}" Text="{Binding TotalDeathsAppearanceDraft.ShadowBlur}" AutomationProperties.Name="Total Deaths shadow blur"/></Grid>
                                            </StackPanel>
                                            <Button Margin="120,2,0,0" HorizontalAlignment="Left" Click="ApplyTotalDeathsAppearance_Click" Content="Apply Total Deaths appearance"/>
                                            <TextBlock Margin="120,6,0,0" Foreground="#E06C75" Text="{Binding TotalDeathsAppearanceStatus}" AutomationProperties.Name="Total Deaths appearance apply status" />
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                                <Button x:Name="ResetSelectedOverlayAppearanceButton" Margin="12,10,12,0" HorizontalAlignment="Left" Click="ResetSelectedOverlayAppearance_Click" Content="Reset selected overlay to defaults" AutomationProperties.Name="Reset selected overlay appearance" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                </Grid>
            </TabItem>
            <TabItem x:Name="SettingsWorkspaceTab" Header="Settings" AutomationProperties.Name="Settings workspace">
                <ScrollViewer x:Name="SettingsContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,24,24,16" AutomationProperties.Name="Settings workspace content">
                <StackPanel x:Name="SettingsContentStack">
                    <Border Style="{StaticResource Panel}" AutomationProperties.Name="Manual update check settings">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="UPDATES" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,8" Text="Checks GitHub for the latest updates." />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckForUpdatesButton" Content="Check for updates" Click="CheckForUpdates_Click" IsEnabled="{Binding CanCheckForUpdates}" AutomationProperties.Name="Check for updates" />
                                <Button x:Name="RetryUpdateCheckButton" Margin="8,0,0,0" Content="Retry" Click="CheckForUpdates_Click" IsEnabled="{Binding CanRetryUpdateCheck}" Visibility="{Binding CanRetryUpdateCheck, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Retry update check" />
                                <Button x:Name="OpenUpdateReleasePageButton" Margin="8,0,0,0" Content="Open release page" Click="OpenUpdateReleasePage_Click" IsEnabled="{Binding CanOpenAvailableUpdateReleasePage}" Visibility="{Binding CanOpenAvailableUpdateReleasePage, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Open available update release page" />
                            </StackPanel>
                            <StackPanel x:Name="UpdateVersionSummary" Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding HasCheckedForUpdates, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Update check result" AutomationProperties.LiveSetting="Polite">
                                <TextBlock Style="{StaticResource MutedText}" Text="Current Version: " />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding UpdateCurrentVersion}" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="12,0" Text="|" />
                                <TextBlock Style="{StaticResource MutedText}" Text="Latest Version: " />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding UpdateLatestVersion}" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="12,0" Text="|" />
                                <TextBlock Style="{StaticResource MutedText}" Text="Status: " />
                                <TextBlock x:Name="UpdateCheckStatusTextBlock" Style="{StaticResource MutedText}" Text="{Binding UpdateCheckStatus}" AutomationProperties.Name="Update check status" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,14,0,0" AutomationProperties.Name="OBS text export settings">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="OBS TEXT EXPORT" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,8" Text="Write local TXT files for OBS Text sources." />
                            <StackPanel x:Name="DeathsExportToggleRow" Orientation="Horizontal">
                                <CheckBox x:Name="DeathsExportEnabledCheckBox" Height="16" IsChecked="{Binding IsDeathsExportEnabled, Mode=OneWay}" Checked="DeathsExportEnabled_Checked" Unchecked="DeathsExportEnabled_Unchecked" AutomationProperties.Name="Enable writing Deaths to txt file">
                                    <TextBlock><Run Text="Enable writing " /><Run FontWeight="Bold" Text="Deaths" /><Run Text=" to txt file" /></TextBlock>
                                </CheckBox>
                            </StackPanel>
                            <TextBlock x:Name="DeathsExportFileNameTextBlock" Text="{Binding DeathsExportFileName, Mode=OneWay, TargetNullValue=No file selected.}" AutomationProperties.Name="Deaths export file name" />
                            <StackPanel Orientation="Horizontal"><Button x:Name="ChooseDeathsExportButton" Content="Choose…" Click="ChooseDeathsExport_Click" IsEnabled="{Binding CanChooseDeathsExport}" AutomationProperties.Name="Choose deaths text file" /><Button x:Name="ClearDeathsExportButton" Margin="8,0,0,0" Content="Clear" Click="ClearDeathsExport_Click" IsEnabled="{Binding CanClearDeathsExport}" AutomationProperties.Name="Clear deaths text file" /></StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#1B1F26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,10">
            <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">More at <Hyperlink x:Name="BeingKairoAttributionHyperlink" NavigateUri="https://www.beingkairo.com/" RequestNavigate="BeingKairoAttributionHyperlink_RequestNavigate" AutomationProperties.Name="Visit beingkairo.com (opens in default browser)" ToolTip="Open beingkairo.com in your default browser">beingkairo.com</Hyperlink></TextBlock>
        </Border>

        <Grid x:Name="HotkeyRecordingOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="20"
              Background="#A8000000"
              Visibility="{Binding IsHotkeyRecording, Converter={StaticResource BooleanToVisibilityConverter}}"
              Focusable="True"
              AutomationProperties.Name="Global hotkey recording">
            <Border Width="430" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#20242B" BorderBrush="#A78BFA" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,9,0" Fill="#FF4D4D" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Global hotkey recording" />
                    </StackPanel>
                    <TextBlock Margin="0,18,0,0" Style="{StaticResource MutedText}" Text="Press the input that you want to use as a hotkey then click enter to save." />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="Press ESC to cancel." />
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="EldenRingNoticeOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="21"
              Background="#A8000000"
              Visibility="{Binding IsEldenRingNoticeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              FocusManager.IsFocusScope="True"
              AutomationProperties.Name="Set up Elden Ring">
            <Border x:Name="EldenRingNoticeDialog" Width="480" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#20242B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Set up Elden Ring" />
                    <TextBlock Margin="0,18,0,0" Style="{StaticResource MutedText}" Text="All Elden Ring characters are stored in ER0000.sl2." />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="Choose the save file and character to track." />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="Typical location: %APPDATA%\EldenRing\&lt;your Steam ID&gt;\ER0000.sl2" />
                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="EldenRingNoticeCancelButton" Margin="0,0,8,0" Content="Not now" Click="CancelEldenRingNotice_Click" AutomationProperties.Name="Not now" />
                        <Button x:Name="EldenRingNoticeConfirmButton" Content="Got it" IsDefault="True" Click="ConfirmEldenRingNotice_Click" AutomationProperties.Name="Got it" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
