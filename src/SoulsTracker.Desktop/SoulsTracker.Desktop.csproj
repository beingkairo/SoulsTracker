<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SoulsTracker.Application\SoulsTracker.Application.csproj" />
    <ProjectReference Include="..\SoulsTracker.Infrastructure\SoulsTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\SoulsTracker.Overlay\SoulsTracker.Overlay.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="..\..\assets\branding\souls-tracker-skull-compact.ico">
      <Link>assets\branding\souls-tracker-skull-compact.ico</Link>
    </Resource>
    <Resource Include="..\..\assets\branding\souls-tracker-skull-compact.png">
      <Link>assets\branding\souls-tracker-skull-compact.png</Link>
    </Resource>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Release notices and inventory are reviewed for this exact self-contained runtime. -->
    <RuntimeFrameworkVersion>10.0.9</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <ApplicationIcon>../../assets/branding/souls-tracker-skull-compact.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="BuildAppearancePreview" BeforeTargets="PrepareResources"
          Inputs="../../web_overlay/scripts/build-preview.mjs;../../web_overlay/src/preview-entry.ts;../../web_overlay/src/hosted-renderer.ts;../../web_overlay/src/overlay.css;../../assets/branding/souls-tracker-skull.png"
          Outputs="$(IntermediateOutputPath)AppearancePreview.html">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../web_overlay/scripts/build-preview.mjs&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)AppearancePreview.html&quot;" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)AppearancePreview.html" LogicalName="SoulsTracker.Desktop.AppearancePreview.html" />
  </ItemGroup>
</Project>
