<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Soulstracker.DeathTracker</AssemblyName>
    <RootNamespace>Soulstracker.DeathTracking</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApiDirectory>$(MSBuildProjectDirectory)/obj/api-v77</ApiDirectory>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp"><HintPath>$(ApiDirectory)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MMHOOK_Assembly-CSharp"><HintPath>$(ApiDirectory)/MMHOOK_Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="PrepareOfficialApiReferences" BeforeTargets="ResolveAssemblyReferences">
    <MakeDir Directories="$(ApiDirectory)" />
    <DownloadFile Condition="!Exists('$(ApiDirectory)/api.zip')" SourceUrl="https://github.com/hk-modding/api/releases/download/1.5.78.11833-77/moddingapi.v77.windows.zip" DestinationFolder="$(ApiDirectory)" DestinationFileName="api.zip" />
    <GetFileHash Files="$(ApiDirectory)/api.zip" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="ApiArchiveHash" /></GetFileHash>
    <Error Condition="'@(ApiArchiveHash->'%(FileHash)')' != 'BC9F0DB3D0916B05CD5A2420BB602FB1B239CE3FF6C289FD84BFFB682FB8F1D6'" Text="The official Hollow Knight API reference archive checksum is invalid." />
    <Unzip SourceFiles="$(ApiDirectory)/api.zip" DestinationFolder="$(ApiDirectory)" SkipUnchangedFiles="true" />
  </Target>
</Project>
