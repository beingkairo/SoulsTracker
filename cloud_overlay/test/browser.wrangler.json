{
  "name": "soulstracker-local-browser-test",
  "main": "browser-worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "PUBLISHER_RATE_LIMITER", "namespace_id": "950501", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIVE_RATE_LIMITER", "namespace_id": "950502", "simple": { "limit": 120, "period": 60 } },
    { "name": "PROVISIONING_RATE_LIMITER", "namespace_id": "950503", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": { "PROVISIONED_IDS": ["11111111111111111111111111111111"], "PROVISIONING_SLOTS": [], "BROWSER_ORIGIN": "https://localhost:8799" },
  "durable_objects": { "bindings": [{ "name": "OVERLAYS", "class_name": "OverlayState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OverlayState"] }],
  "assets": { "directory": "../../web_overlay/dist/hosted", "run_worker_first": ["/api/*", "/__test/*"] }
}
