{
  "name": "soulstracker-policy-operator",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "routes": [{ "pattern": "soulstracker-operator.beingkairo.com", "custom_domain": true }],
  "vars": {
    "OPERATOR_ENABLED": "false",
    "OPERATOR_HOST": "soulstracker-operator.beingkairo.com"
  },
  "services": [
    { "binding": "POLICY_READ", "service": "soulstracker-cloud-overlay", "entrypoint": "PolicyReadEntrypoint" },
    { "binding": "POLICY_APPLY", "service": "soulstracker-cloud-overlay", "entrypoint": "PolicyApplyEntrypoint" }
  ]
}
